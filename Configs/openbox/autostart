## Kill if already running
killall -9 xfsettingsd picom polybar mpd dunst ksuperkey xfce4-power-manager

## Restore Wallpaper
nitrogen --restore

## xfce4-settings daemon
xfsettingsd &

## polkit agent
if [[ ! `pidof xfce-polkit` ]]; then
	/usr/lib/xfce-polkit/xfce-polkit &
fi

## Enable power management
xfce4-power-manager &

## Start Compositing Manager
exec picom &

## Launch Polybar or Tint2
bash ~/.config/openbox/themes/launch-bar.sh

## Notification Daemon
exec dunst &

## Start Music Player Daemon
exec mpd &

## Launch Plank
#exec plank &

## Thunar Daemon
exec thunar --daemon &

## Enable Super Keys For Menu
ksuperkey -e 'Super_L=Alt_L|F1' &
ksuperkey -e 'Super_R=Alt_L|F1' &

## keyd: atajos macOS por aplicación (Cmd+C/V en terminales, etc.)
## Config: ~/.config/keyd/app.conf  |  Log: ~/.cache/keyd-app-focus.log
## (keyd-application-mapper no sirve aquí: confunde polybar con la ventana activa)
if command -v keyd >/dev/null; then
	pkill -f '^python3 .*/keyd-app-focus.py'
	python3 ~/.local/bin/keyd-app-focus.py > ~/.cache/keyd-app-focus.log 2>&1 &
fi

## These applets are specifically for tint2 panel.
## If you're using tint2 as panel, Uncomment these applets.

## User Friendly Network Menu
#nm-applet --indicator &

## User Friendly Bluetooth Menu
#blueman-applet &

